# ===== Resource DB =====
RESOURCE_DB_NAME=resource_service_db
RESOURCE_DB_USER=resource_user
RESOURCE_DB_PASSWORD=resource_pass

# ===== Song DB =====
SONG_DB_NAME=song_service_db
SONG_DB_USER=song_user
SONG_DB_PASSWORD=song_pass

# ===== Resource Service =====
RESOURCE_SERVICE_PORT=8081
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource_service_db

# ===== Song Service =====
SONG_SERVICE_PORT=8082
SONG_DB_URL=jdbc:postgresql://song-db:5432/song_service_db

# ===== Resource Processor =====
RESOURCE_PROCESSOR_PORT=8083

# ===== Eureka =====
EUREKA_SERVER_PORT=8761
EUREKA_URL=http://eureka-server:8761/eureka

# ===== S3 / LocalStack =====
S3_ENDPOINT=http://localstack:4566
S3_BUCKET_NAME=resource-files-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# ===== RabbitMQ =====
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ===== RabbitMQ Queue config =====
RESOURCE_PROCESSING_EXCHANGE=resource.processing.exchange
RESOURCE_PROCESSING_QUEUE=resource.processing.queue
RESOURCE_PROCESSING_ROUTING_KEY=resource.processing.key